# Supabase (obrigatório - configurar também na Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Opcional localmente (apenas leitura de schema / administração)
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (necessário para leitura automática de faturas anexadas - configurar também na Vercel)
# Modelo padrão: gpt-6-luna ($0.10/1M input, $0.50/1M output, suporte nativo a PDF, Visão e Structured Outputs)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-6-luna
